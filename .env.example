# ==== LifeSciHub 环境变量配置模板（复制为 .env 使用）====

# 运行模式：
#   0 = 开发/演示模式（首次启动写入演示账号 admin/admin123 等，可在登录页一键填充）
#   1 = 公开模式（不生成任何演示账号！站点内容种子保留，首个注册用户自动成为管理员）
PUBLIC_MODE=1

# 监听端口（默认 3000；经 Nginx/Caddy 反代时保持 3000 即可）
#PORT=3000

# 会话有效期（天，默认 7）
SESSION_TTL_DAYS=7

# 自动更新间隔（小时，默认 12 = 每天两次）
UPDATE_INTERVAL_HOURS=12

# 是否位于反向代理之后（1 = 是，使限流按真实客户端 IP 生效）
TRUST_PROXY=1

# 限流配置（每 IP/用户 每小时）
#RATE_REGISTER_MAX=10
#RATE_LOGIN_MAX=20
#RATE_WRITE_MAX=120

# 备份保留份数（默认 20）
#BACKUP_KEEP=20

# ==== 翻译通道（百度优先，MyMemory 兜底）====
# 百度翻译 API Key（在 https://fanyi-api.baidu.com/manage/apiKey 获取，需先完成实名认证并开通通用翻译）
# 填写后全站文献中文标题、眼科AI日报中文摘要将优先使用百度翻译（速度快、术语更准）
#TRANS_API_KEY=你的百度翻译APIKey

# trans-cli 可执行文件路径（一般无需设置；仅当自动探测失败时指定）
#TRANS_BIN=/Users/you/lifesci-hub/node_modules/.bin/trans

# 每次自动更新补翻的中文标题条数上限（默认 25）
#TITLE_BACKFILL_MAX=25
